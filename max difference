#include<stdio.h>
int main(){
    int n;
    printf("enter the elements:");
    scanf("%d",&n);
    int arr[n];
    printf("enter the elements to store:");
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    int min=arr[0];
    int max=arr[0];
    for(int i=1;i<n;i++){
        if(max<arr[i]){
            max=arr[i];
        }
        if(min>arr[i]){
            min=arr[i];
        }
        
    }
    int maxdiff=max-min;
    printf("max diffrence is %d",maxdiff);
    return 0;
}
