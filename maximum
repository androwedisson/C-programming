#include<stdio.h>
int main(){
    int n;
    printf("enter the elements:");
    scanf("%d",&n);
    int arr[n];
    printf("enter the elements to store:");
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    int max=arr[0];
    for(int i=0;i<n;i++){
        if(max<arr[i]){
            max=arr[i];
        }
        
    }
  printf("maximum:%d",max);
    return 0;
}
