#include<stdio.h>
int main(){
    int n;
    printf("enter a number:");
    scanf("%d",&n);
    for(int i=1;i<=n-1;i++){
      //  for(int space=1;space<=n;space++){
          //  printf(" ");
        for(int j=1;j<=n-i;j++){
            printf("*");
        }
        printf("\n");
    }
    return 0;
}
